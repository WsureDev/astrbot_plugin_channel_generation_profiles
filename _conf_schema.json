{
  "features": {
    "type": "list",
    "description": "要启用的可选 integration。目标插件未加载时，该 integration 自动跳过。",
    "default": ["comfyui", "image_generation"]
  },
  "profiles": {
    "type": "text",
    "description": "JSON 格式的渠道 profile 配置。AstrBot v4.28 的动态对象 schema 必须使用文本承载。",
    "default": "{\"qq\":{\"platforms\":[\"aiocqhttp\",\"qq_official\",\"qq_official_webhook\"],\"comfyui\":{},\"image_generation\":{}},\"telegram\":{\"platforms\":[\"telegram\"],\"comfyui\":{},\"image_generation\":{}},\"default\":{\"platforms\":[],\"comfyui\":{},\"image_generation\":{}}}"
  },
  "strict_version": {
    "type": "bool",
    "description": "发现不兼容的原插件接口时是否停用对应代理。",
    "default": true
  }
}
